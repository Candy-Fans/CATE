# This file documents required variables. Spring Boot does not load it automatically.
CATE_DB_URL=jdbc:mysql://localhost:3306/cate?useUnicode=true&characterEncoding=utf8&zeroDateTimeBehavior=convertToNull&useSSL=true&serverTimezone=GMT%2B8
CATE_DB_USERNAME=root
CATE_DB_PASSWORD=replace-with-your-local-password
CATE_DRUID_USERNAME=admin
CATE_DRUID_PASSWORD=replace-with-a-monitor-password
CATE_CIPHER_KEY=0123456789abcdef0123456789abcdef
