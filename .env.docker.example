# Optional: Docker Compose already has local-demo defaults, so a fresh clone
# runs with `docker compose up --build -d` without creating a .env file.
# To customize, copy this file to .env in the repository root.
CATE_BIND_ADDRESS=127.0.0.1
CATE_MANAGE_PORT=8080
CATE_CLIENT_PORT=8081
CATE_DB_USERNAME=cate
CATE_DB_PASSWORD=cate-demo-password
CATE_MYSQL_ROOT_PASSWORD=cate-demo-root-password
CATE_DRUID_USERNAME=admin
CATE_DRUID_PASSWORD=cate-demo-monitor-password
# This demo key matches the demo-admin password in cate.sql.
CATE_CIPHER_KEY=0123456789abcdef0123456789abcdef

# Optional image overrides. Leave commented to use each Compose file's defaults:
# compose.release.yaml: candyfans/cate, 1.0.0 (published images)
# compose.yaml: cate, local (build from source)
# CATE_IMAGE_PREFIX=candyfans/cate
# CATE_IMAGE_TAG=1.0.0
